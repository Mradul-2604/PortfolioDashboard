# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the Next.js frontend (Google Stitch export)
FRONTEND_URL=http://localhost:3000

# ─── Cache ────────────────────────────────────────────────────────────────────
# Milliseconds before cached market data expires
# Default: 60000 (60 seconds). Frontend polls every 15s so this prevents
# hammering external providers on every poll.
MARKET_DATA_CACHE_TTL=60000

# ─── Provider Timeouts ────────────────────────────────────────────────────────
# Milliseconds before an external HTTP request is aborted
YAHOO_TIMEOUT=8000
GOOGLE_TIMEOUT=8000

# ─── Rate Limit Handling ──────────────────────────────────────────────────────
# Milliseconds to wait before retrying a rate-limited request (max 1 retry)
PROVIDER_RETRY_DELAY=2000
